# Copy to .env and replace this with a long, random value before starting Compose.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
# Include the LAN/VPN hostname or IP that players will use.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set to the intended LAN/VPN interface; 127.0.0.1 keeps initial setup local.
QUIZ_BIND_ADDRESS=127.0.0.1
QUIZ_PORT=8000
# Replace all four values. Team PINs need at least 6 digits; admin passwords
# need at least 12 characters. Keep .env private and outside version control.
QUIZ_TEAM_A_PIN=replace-with-team-a-six-plus-digit-pin
QUIZ_TEAM_B_PIN=replace-with-team-b-six-plus-digit-pin
QUIZ_ADMIN_ONE_PASSWORD=replace-with-unique-admin-one-password
QUIZ_ADMIN_TWO_PASSWORD=replace-with-unique-admin-two-password
