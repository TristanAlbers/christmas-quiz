# Copy to .env and replace this with a long, random value before starting Compose.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
# Include the LAN/VPN hostname or IP that players will use.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set to the intended LAN/VPN interface; 127.0.0.1 keeps initial setup local.
QUIZ_BIND_ADDRESS=127.0.0.1
QUIZ_PORT=8000
